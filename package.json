{
  "name": "glitchflow",
  "displayName": "GlitchFlow",
  "description": "Visualize sequence diagrams and database/file states together in VS Code.",
  "version": "0.1.2",
  "license": "MIT",
  "icon": "images/icon.png",
  "publisher": "Glitch-Sound",
  "repository": {
    "type": "git",
    "url": "https://github.com/Glitch-Sound/glitchflow.git"
  },
  "homepage": "https://github.com/Glitch-Sound/glitchflow#readme",
  "bugs": {
    "url": "https://github.com/Glitch-Sound/glitchflow/issues"
  },
  "keywords": [
    "sequence diagram",
    "sequence-diagram",
    "uml",
    "flow diagram",
    "database",
    "data state",
    "software design",
    "system design",
    "dsl",
    "glf"
  ],
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages"
  ],
  "main": "./dist/extension/extension.js",
  "activationEvents": [
    "onCommand:glitchflow.openPreview",
    "onCommand:glitchflow.exportDiagram",
    "onLanguage:glitchflow"
  ],
  "contributes": {
    "languages": [
      {
        "id": "glitchflow",
        "aliases": [
          "GlitchFlow",
          "glf"
        ],
        "extensions": [
          ".glf"
        ]
      }
    ],
    "grammars": [
      {
        "language": "glitchflow",
        "scopeName": "source.glf",
        "path": "./syntaxes/glf.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "GlitchFlow",
      "properties": {
        "glitchflow.syntaxHighlighting": {
          "type": "string",
          "enum": [
            "theme",
            "glitchflow"
          ],
          "default": "theme",
          "description": "`.glf`のエディタ構文配色"
        },
        "glitchflow.preview.autoOpen": {
          "type": "boolean",
          "default": true,
          "description": "`.glf`をエディタで開いたときにプレビューを自動表示する"
        }
      }
    },
    "commands": [
      {
        "command": "glitchflow.openPreview",
        "title": "GlitchFlow: プレビューを開く",
        "icon": "$(open-preview)"
      },
      {
        "command": "glitchflow.exportDiagram",
        "title": "GlitchFlow: 図をエクスポート"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "glitchflow.openPreview",
          "when": "resourceExtname == .glf",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run build:extension && npm run build:webview",
    "build:extension": "node esbuild.mjs",
    "build:webview": "vite build",
    "dev:webview": "vite --host 127.0.0.1",
    "check": "npm run check:biome && npm run check:fsd && npm run typecheck && npm run test",
    "check:biome": "biome check .",
    "check:fsd": "steiger ./src/webview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts tests/core",
    "test:visual": "playwright test",
    "test:extension": "npm run build && node scripts/run-extension-tests.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@feature-sliced/steiger-plugin": "^0.8.0",
    "@fission-ai/openspec": "^1.15.0",
    "@playwright/test": "^1.64.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.140.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "lefthook": "^2.2.2",
    "mocha": "^12.0.3",
    "steiger": "^0.8.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
