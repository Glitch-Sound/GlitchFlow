{
  "name": "glitchflow",
  "displayName": "GlitchFlow",
  "description": "処理の流れとデータの状態を可視化するVS Code拡張機能",
  "version": "0.0.1",
  "private": true,
  "publisher": "glitch-sound",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Visualization"
  ],
  "main": "./dist/extension/extension.js",
  "activationEvents": [
    "onCommand:glitchflow.openPreview",
    "onLanguage:glitchflow"
  ],
  "contributes": {
    "languages": [
      {
        "id": "glitchflow",
        "aliases": [
          "GlitchFlow",
          "glf"
        ],
        "extensions": [
          ".glf"
        ]
      }
    ],
    "grammars": [
      {
        "language": "glitchflow",
        "scopeName": "source.glf",
        "path": "./syntaxes/glf.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "GlitchFlow",
      "properties": {
        "glitchflow.syntaxHighlighting": {
          "type": "string",
          "enum": [
            "theme",
            "glitchflow"
          ],
          "default": "theme",
          "description": "`.glf`のエディタ構文配色"
        }
      }
    },
    "commands": [
      {
        "command": "glitchflow.openPreview",
        "title": "GlitchFlow: プレビューを開く"
      }
    ]
  },
  "scripts": {
    "build": "npm run build:extension && npm run build:webview",
    "build:extension": "node esbuild.mjs",
    "build:webview": "vite build",
    "dev:webview": "vite --host 127.0.0.1",
    "check": "npm run check:biome && npm run check:fsd && npm run typecheck && npm run test",
    "check:biome": "biome check .",
    "check:fsd": "steiger ./src/webview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts tests/core",
    "test:visual": "playwright test",
    "test:extension": "npm run build && node scripts/run-extension-tests.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@feature-sliced/steiger-plugin": "^0.8.0",
    "@fission-ai/openspec": "^1.15.0",
    "@playwright/test": "^1.64.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.140.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "lefthook": "^2.2.2",
    "mocha": "^12.0.3",
    "steiger": "^0.8.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
